# Dev image: Go toolchain + air for hot-reload. Source is bind-mounted from the
# host (see root docker-compose.yml), so changes rebuild live. NOT for prod —
# the production image is the multi-stage distroless build in ./Dockerfile.
FROM golang:alpine

RUN apk add --no-cache git ca-certificates tzdata \
    && go install github.com/air-verse/air@latest

WORKDIR /app

# air config, build cmd and watched extensions live in .air.toml (bind-mounted).
CMD ["air"]
